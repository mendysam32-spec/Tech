{
  "name": "tech-monster",
  "productName": "Tech Monster",
  "version": "1.2.0",
  "description": "Study notes, quizzes and past papers — works offline, syncs when online.",
  "main": "electron/main.js",
  "author": "S&P Group",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "android:web": "node scripts/build-android-web.cjs",
    "android:sync": "npm run android:web && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "build": {
    "appId": "com.spgroup.techmonster",
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "publisherName": "S&P Group",
      "artifactName": "Tech-Monster-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tech Monster"
    },
    "directories": {
      "app": ".",
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**/*",
      "!.git/**/*",
      "!.wrangler/**/*",
      "!build_foundation_science.cjs",
      "!build_ses_fullnotes.cjs",
      "!CLOUDFLARE_SETUP.md",
      "!FRESH_DEPLOY_CHECKLIST.md",
      "!cloudflare/**/*",
      "!wrangler.toml",
      "!android/**/*",
      "!www/**/*",
      "!scripts/**/*",
      "!capacitor.config.json",
      "!.gitattributes",
      "!.gitignore"
    ],
    "publish": {
      "provider": "github",
      "repo": "Tech",
      "owner": "mendysam32-spec"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "electron-updater": "^6.0.0"
  }
}
